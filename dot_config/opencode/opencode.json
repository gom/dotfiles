{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "bash": {
      "*": "ask",

      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "pwd": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "realpath *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "date": "allow",
      "date *": "allow",
      "echo *": "allow",

      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git grep *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "git config --get *": "allow",
      "git config --list": "allow",
      "git config --list *": "allow",
      "git add *": "allow",

      "find": "ask",
      "find *": "ask",
      "mkdir *": "ask",

      "git commit": "ask",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git checkout": "ask",
      "git checkout *": "ask",
      "git switch": "ask",
      "git switch *": "ask",
      "git restore": "ask",
      "git restore *": "ask",
      "git reset": "ask",
      "git reset *": "ask",
      "git merge": "ask",
      "git merge *": "ask",
      "git rebase": "ask",
      "git rebase *": "ask",
      "git cherry-pick": "ask",
      "git cherry-pick *": "ask",
      "git revert": "ask",
      "git revert *": "ask",
      "git fetch": "ask",
      "git fetch *": "ask",
      "git pull": "ask",
      "git pull *": "ask",

      "rm *": "ask",
      "rmdir *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "chmod *": "ask",
      "chown *": "ask",

      "bash": "ask",
      "bash *": "ask",
      "sh": "ask",
      "sh *": "ask",
      "zsh": "ask",
      "zsh *": "ask",

      "sudo": "deny",
      "sudo *": "deny",

      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git clean": "deny",
      "git clean *": "deny",

      "git push --force": "deny",
      "git push --force *": "deny",
      "git push * --force": "deny",
      "git push * --force *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",

      "rtk ls": "allow",
      "rtk ls *": "allow",
      "rtk cat *": "allow",
      "rtk pwd": "allow",
      "rtk grep *": "allow",
      "rtk rg *": "allow",
      "rtk head *": "allow",
      "rtk tail *": "allow",
      "rtk wc *": "allow",
      "rtk file *": "allow",
      "rtk stat *": "allow",
      "rtk realpath *": "allow",
      "rtk tree": "allow",
      "rtk tree *": "allow",
      "rtk jq *": "allow",
      "rtk diff *": "allow",
      "rtk date": "allow",
      "rtk date *": "allow",
      "rtk echo *": "allow",

      "rtk git status": "allow",
      "rtk git status *": "allow",
      "rtk git log *": "allow",
      "rtk git rev-parse *": "allow",
      "rtk git remote": "allow",
      "rtk git remote *": "allow",
      "rtk git diff": "allow",
      "rtk git diff *": "allow",
      "rtk git show *": "allow",
      "rtk git ls-files": "allow",
      "rtk git ls-files *": "allow",
      "rtk git grep *": "allow",
      "rtk git branch": "allow",
      "rtk git branch --show-current": "allow",
      "rtk git branch --list": "allow",
      "rtk git branch --list *": "allow",
      "rtk git config --get *": "allow",
      "rtk git config --list": "allow",
      "rtk git config --list *": "allow",
      "rtk git add *": "allow",
      "rtk sudo": "deny",
      "rtk sudo *": "deny",

      "rtk git reset --hard": "deny",
      "rtk git reset --hard *": "deny",
      "rtk git clean": "deny",
      "rtk git clean *": "deny",

      "rtk git push --force": "deny",
      "rtk git push --force *": "deny",
      "rtk git push * --force": "deny",
      "rtk git push * --force *": "deny",
      "rtk git push -f": "deny",
      "rtk git push -f *": "deny",
      "rtk git push * -f": "deny",
      "rtk git push * -f *": "deny",
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["/usr/local/bin/github-mcp-server", "stdio"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_TOKEN"
      }
    },
    "drawio": {
      "type": "remote",
      "url": "https://mcp.draw.io/mcp",
      "enabled": true
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=$TAVILY_API_KEY",
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "headroom-ai[mcp]",
        "headroom",
        "mcp",
        "serve"
      ]
    }
  },
  "plugin": [
    "context-mode",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "{env:OLLAMA_BASE_URL}/v1"
      },
      "models": {
        "qwen3.6:27b": {
          "name": "Qwen 3.6 27B"
        },
        "qwen3.6:35b-a3b": {
          "name": "Qwen 3.6 35B A3B"
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B"
        },
        "gemma4:12b": {
          "name": "Gemma 4 12B"
        },
        "gemma4:e4b": {
          "name": "Gemma 4 E4B"
        }
      }
    },
    "openrouter" : {
      "models": {
        "z-ai/glm-5.2":{
          "name": "[Manual] GLM 5.2",
          "options": {
            "provider": {
              "order": ["novita", "streamlake"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "z-ai/glm-5.3":{
          "name": "[Manual] GLM 5.3",
          "options": {
            "provider": {
              "order": ["z-ai"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "z-ai/glm-5.3-flash":{
          "name": "[Manual] GLM 5.3 Flash",
          "options": {
            "provider": {
              "order": ["z-ai", "novita", "relace"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "name": "[Manual] DeepSeek V4 Flash 0731",
          "options": {
            "provider": {
              "order": ["gmicloud", "deepseek", "deepinfra"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "deepseek/deepseek-v4-pro": {
          "name": "[Manual] DeepSeek V4 Pro",
          "options": {
            "provider": {
              "order": ["deepseek", "streamlake"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "[Manual] Kimi K2.7 Code",
          "options": {
            "provider": {
              "order": ["moonshotai", "siliconflow"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "moonshotai/kimi-k3": {
          "name": "[Manual] Kimi K3",
          "options": {
            "provider": {
              "order": ["moonshotai", "modal"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "tencent/hy3": {
          "name": "[Manual] Hy3",
          "options": {
            "provider": {
              "order": ["tencent"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "qwen/qwen3.8-max": {
          "name": "[Manual] Qwen 3.8 Max"
        },
        "minimax/minimax-m3": {
          "name": "[Manual] MiniMax M3",
