          }
        },
        "openai/gpt-5.6-luna": {
          "name": "[Manual] GPT-5.6 Luna",
          "options": {
            "provider": {
              "order": ["openai"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
        "anthropic/claude-sonnet-5": {
          "name": "[Manual] Claude Sonnet 5",
          "options": {
            "provider": {
              "order": ["anthropic"],
              "allow_fallbacks": false,
              "sort": "price"
            }
          }
        },
      }
    }
  },
  "enabled_providers": ["openrouter"],
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731"
}
